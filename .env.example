NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# GPT OCR model. gpt-4o-mini is cheaper; use a stronger vision-capable model if you need higher accuracy.
OPENAI_OCR_MODEL=gpt-4o-mini
OCR_PROVIDER=openai
# OCR_PROVIDER=openai uses GPT OCR. For free local OCR testing, use OCR_PROVIDER=tesseract.
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_STORAGE_BUCKET=receipts
